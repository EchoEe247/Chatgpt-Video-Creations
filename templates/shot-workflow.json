{
  "schema_version": 1,
  "work_dir": "shot-work",
  "shots": [
    {
      "id": "shot-01",
      "intent": "Describe the visible action and purpose of this shot.",
      "criteria": [
        "composition",
        "silhouette",
        "contact_and_prop_alignment"
      ],
      "motion_criteria": [
        "acting_and_timing",
        "temporal_integrity"
      ],
      "sources": [
        "scene.blend",
        "{repo}/scripts/blender_termux_adapter.py",
        "{repo}/scripts/blender_shot_adapter.py"
      ],
      "renderer": [
        "python",
        "{repo}/scripts/blender_termux_adapter.py",
        "{request}"
      ],
      "width": 640,
      "height": 360,
      "fps": 24,
      "duration_seconds": 3,
      "source_offset_seconds": 0,
      "review_seconds": [
        1.5
      ],
      "settings": {
        "engine": "BLENDER_WORKBENCH",
        "runtime_tag": "blender-4.0.2-hermes-ubuntu"
      }
    }
  ],
  "batch_size": 1
}
