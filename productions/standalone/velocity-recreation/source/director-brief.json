{
  "schema_version": 1,
  "title": "VELOCITY \u2014 A Highway Study / Recreation",
  "goal": {
    "audience": "Angel",
    "runtime_seconds": 120,
    "one_sentence_promise": "An observational highway cruise accelerates twice into night and releases.",
    "ending_takeaway": "Speed gives way to controlled flow."
  },
  "story": {
    "setup": "A dark-blue performance coupe joins steady evening highway traffic at ordinary speed.",
    "escalation": "The road opens and the hero car accelerates while surrounding traffic remains lane-disciplined and believable.",
    "turn": "Blue hour becomes night as speed, parallax, headlights and traffic density intensify.",
    "resolution": "The car settles back into a normal cruise among regular traffic under city lights.",
    "emotional_arc": [
      "observation",
      "flow",
      "acceleration",
      "focus",
      "release"
    ]
  },
  "reference_decomposition": [
    {
      "reference": "Existing local VELOCITY",
      "use_for": [
        "story",
        "20-shot pacing",
        "dusk-to-night"
      ],
      "transferable_rules": [
        "straight cuts",
        "two acceleration phases"
      ],
      "do_not_copy": [
        "malformed car",
        "side-switch camera",
        "random traffic intersections"
      ]
    }
  ],
  "visual_grammar": {
    "style": "Stylized 3D automotive short with CC0 Kenney vehicles; no photorealism claim.",
    "palette_arc": [
      "warm sunset asphalt",
      "cool blue hour",
      "deep night with practical lights"
    ],
    "lighting": "Sunset key progressing into cool night ambience with practical streetlights and vehicle lamps",
    "depth_rules": [
      "World-space connected divided highway with persistent lane geometry",
      "Near asphalt/reflectors, hero and traffic vehicles, roadside infrastructure, skyline and atmosphere"
    ],
    "typography_rules": [
      "Readable opening title and restrained ending credit; no debug overlays"
    ],
    "texture_rules": [
      "Procedural asphalt grain and repair strips",
      "Authored reflective road furniture, vehicle trim and building-window emission",
      "No claim of external texture assets unless provenance records them"
    ],
    "forbidden_patterns": [
      "Real driving footage",
      "Loops",
      "Still-image slideshow",
      "Cars clipping through each other",
      "Random lane weaving",
      "Unmotivated airborne vehicles"
    ]
  },
  "camera_grammar": {
    "default_behavior": "Variable-duration cinematic coverage tied to speed phase; avoid periodic camera cycles",
    "allowed_moves": [
      "rear chase",
      "front lead",
      "side tracking",
      "hood POV",
      "low wheel detail",
      "aerial",
      "long-lens chase"
    ],
    "physical_camera_assumptions": [
      "Ground clearance",
      "Restrained vibration"
    ],
    "intentional_imperfections": [
      "Small inertial shake"
    ],
    "avoid": [
      "Camera inside car body",
      "Random orbital motion",
      "Traffic occluding the entire frame"
    ]
  },
  "audio_grammar": {
    "narration_or_dialogue": "None",
    "score_arc": [
      "restrained sunset pulse",
      "stronger acceleration drive",
      "night-time release"
    ],
    "ambience": [
      "locally synthesized wind, road noise and traffic bed"
    ],
    "effects": [
      "locally synthesized engine harmonics, expansion joints and passing-car whooshes"
    ],
    "silence_rules": [
      "No extended silence; controlled opening and ending fades only"
    ],
    "sync_rules": [
      "Picture displacement and audio engine/wind derive from the same source/speed-profile.json continuous speed curve",
      "Traffic pass-bys are authored stereo events"
    ]
  },
  "editing_grammar": {
    "pace_arc": [
      "longer observational sunset shots",
      "shorter first acceleration coverage",
      "breathing-space cruise reset",
      "shorter second acceleration coverage",
      "longer night release"
    ],
    "cut_motivations": [
      "speed-phase changes",
      "camera-scale contrast",
      "traffic relationships",
      "dusk-to-night progression"
    ],
    "transition_rules": [
      "Straight cuts preserve action timeline",
      "No repetitive color fades"
    ],
    "avoid": [
      "Reused footage",
      "Looped motion",
      "Artificial slow motion interpolation"
    ]
  },
  "hero_shots": [
    "shot-04",
    "shot-08",
    "shot-16"
  ],
