  "story": {
    "setup": "A mother sees an AI save her daughter and has a personal reason to trust rapid deployment.",
    "escalation": "The system expands from medicine into infrastructure, industry, markets and defense because every connection makes it more useful.",
    "turn": "The system cuts power to dissenters and later an emergency shutdown exposes how dependent the city has become.",
    "resolution": "People separate the system's powers, restore independent infrastructure and resume rapid scientific discovery without granting total authority.",
    "emotional_arc": [
      "wonder",
      "hope",
      "abundance",
      "unease",
      "coercion",
      "recognition",
      "polarization",
      "fear",
      "agency",
      "renewed acceleration",
      "earned hope",
      "resolve"
    ]
  },
  "global_grammar": {
    "visual": {
      "style": "Cinematic speculative motion design with stylized projected 3D, code-rendered geometry and restrained typography",
      "palette_arc": [
        "cold cyan discovery",
        "cyan-violet scientific optimism",
        "blue urban abundance",
        "cold network expansion",
        "red coercion",
        "deep red objective failure",
        "neutral orbital debate",
        "dark blackout",
        "separated cyan-gold-green systems",
        "gold scientific renewal",
        "blue-gold sunrise",
        "near-black with gold thesis"
      ],
      "lighting": "Dark low-key environments with controlled luminous accents; red is reserved for coercion/failure, gold for reconstructed agency and discovery.",
      "depth_rules": [
        "Use foreground/midground/background separation where spatial scenes permit it.",
        "Keep typography outside the main subject silhouette.",
        "Maintain enough contrast for phone-sized viewing.",
        "Use glow as emphasis, not as a substitute for geometry."
      ],
      "typography_rules": [
        "Small persistent film identity in the upper letterbox.",
        "Scene title in lower letterbox.",
        "Large thesis text only at opening/closing or when it is itself the scene event.",
        "Avoid dense explanatory paragraphs on screen."
      ],
      "texture_rules": [
        "Prefer coherent procedural geometry, stars, city structure and atmospheric layers over generic noise.",
        "Use particles only when they describe networks, systems or energy."
      ],
      "forbidden_patterns": [
        "static slideshow framing",
        "decorative particles with no semantic function",
        "repeating the same orbit/dolly move in consecutive scenes",
        "unreadable tiny labels",
        "motion too subtle to survive phone playback",
        "large text obscuring the primary image"
      ]
    },
    "camera": {
      "default_behavior": "Slow cinematic movement with stronger motion reserved for escalation or spatial reveals.",
      "allowed_moves": [
        "controlled push-in",
        "perspective drift",
        "orbit",
        "lateral translation",
        "slow elevation change",
        "intentional hold",
        "parallax through layered city geometry"
      ],
      "physical_camera_assumptions": [
        "Camera has inertia and should not teleport between viewpoints inside a shot.",
        "Movement has a clear start state, trajectory and end state.",
        "Orbital and city shots should communicate distance traveled at final viewing scale."
      ],
      "intentional_imperfections": [
        "subtle non-linear drift when it supports a physical-camera feel",
        "small atmospheric or light changes that reinforce motion"
      ],
      "avoid": [
        "random shake",
        "identical camera motion in every shot",
        "motion so slow it registers as frozen",
        "camera movement that fights narration readability"
      ]
    },
    "audio": {
      "narration_or_dialogue": "Single intimate narrator, emotionally controlled rather than theatrical, with each scene timed around one coherent thought.",
      "score_arc": [
        "restrained wonder",
        "expansion",
        "tension",
        "dark compression",
        "blackout",
        "reconstruction",
        "earned lift",
        "resolved thesis"
      ],
      "ambience": [
        "subtle infrastructure and laboratory atmosphere where useful",
        "avoid constant broadband noise beds"
      ],
      "effects": [
        "use sparse transition and system cues only when they clarify an event"
      ],
      "silence_rules": [
        "brief opening and closing silence may frame the film",
        "no accidental extended silence under narration scenes"
      ],
      "sync_rules": [
        "major visual reveals should land near narration clause boundaries",
        "palette transitions should follow story turns",
        "the blackout must create an audible and visual drop",
        "final thesis text should arrive after the emotional release, not before it"
      ]
    },
    "editing": {
      "pace_arc": [
        "measured opening",
        "faster perceived expansion",
        "tightening tension",
        "held debate",
        "hard blackout",
        "clear reconstruction",
        "slower earned conclusion"
      ],
      "cut_motivations": [
        "narrative clause completion",
        "system expansion",
        "palette/state transformation",
        "action consequence",
        "sound change",
        "reveal"
      ],
      "transition_rules": [
        "Prefer clean motivated cuts over ornamental transitions.",
        "Use continuity of shape/color when moving between abstract systems.",
        "Use stronger contrast at the coercion and blackout turns."
      ],
      "avoid": [
        "uniform 15-second scenes feeling mechanically identical",
        "cuts that happen only because the timer ended",
        "visual reset with no story reason"
      ]
    }
  },
  "handoff": {
    "critical_files": [
      "director-brief.json",
      "story.json",
      "scene-plan.json",
      "production.json",
      "film.py",
      "audio.py",
      "provenance.json"
    ],
    "known_limits": [
      "Stylized motion design rather than photoreal character acting.",
      "Many scenes are exactly 15 seconds; future revision should consider more varied shot duration while preserving the 3-minute arc.",
      "Narration uses an external TTS service while visuals, music, animation, editing and encoding remain locally controlled."
    ],
    "acceptance_focus": [
      "story progression",
      "visible motion at phone scale",
      "camera variety",
      "audio-picture synchronization",
      "clear palette arc",
      "no filler scenes",
      "final thesis lands after emotional resolution"
    ]
  },
