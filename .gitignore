__pycache__/
*.py[cod]
.pytest_cache/
.runtime/
review-packs/
.audit_*
*.tmp
*.log

# Local experimental fan-video workspace remains local-only.
candidates/mandalorian-personal-fan-test/

# Standalone productions: keep bulky/generated work local, but allow a small
# durable source/provenance surface to be tracked per production.
productions/standalone/*
!productions/standalone/*/
productions/standalone/*/*
!productions/standalone/*/README.md
!productions/standalone/*/production.json
!productions/standalone/*/provenance.json
!productions/standalone/*/source/
!productions/standalone/*/source/**

# Downloaded third-party asset payloads stay local. Track provenance/manifests,
# not redistributed bulk, unless a specific production deliberately vendors one.
external-assets/
