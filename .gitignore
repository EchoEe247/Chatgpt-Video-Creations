__pycache__/
node_modules/
*.py[cod]
.pytest_cache/
.runtime/
review-packs/
.audit_*
*.tmp
*.log

# Local experimental fan-video workspace remains local-only.
candidates/mandalorian-personal-fan-test/

# Standalone productions: keep bulky/generated work local, but allow a small
# durable source/provenance surface to be tracked per production.
productions/standalone/*
!productions/standalone/*/
productions/standalone/*/*
!productions/standalone/*/README.md
!productions/standalone/*/production.json
!productions/standalone/*/provenance.json
!productions/standalone/*/source/
!productions/standalone/*/source/**

# Re-apply generated/transient exclusions after the source/** negation above.
productions/standalone/*/source/**/__pycache__/
productions/standalone/*/source/**/*.py[cod]
productions/standalone/*/source/*.pre-*
productions/standalone/*/source/**/*.pre-*

# Derived production metadata is regenerated from durable source inputs.
productions/standalone/*/source/av-events.json
productions/standalone/*/source/av-timeline.json
productions/standalone/*/source/motion-telemetry.json

# Paused/rejected local production retained for possible rebuild; quality lessons are tracked in docs/receipts.
productions/standalone/lax-arrival/

# Machine-local asset payload/state. Catalog, schemas and manifests are tracked.
assets/local-state.json
assets/core/payload/

# Downloaded third-party asset payloads stay local. Track provenance/manifests,
# not redistributed bulk, unless a specific production deliberately vendors one.
external-assets/